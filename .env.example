NODE_ENV=development
PORT=3000

# Authentication (required at startup)
VITE_APP_ID=kindai-estimating-suite
JWT_SECRET=replace-with-a-long-random-secret
OAUTH_SERVER_URL=https://oauth.example.com
VITE_OAUTH_PORTAL_URL=https://portal.example.com
OWNER_OPEN_ID=

# Database (required at startup)
DATABASE_URL=mysql://user:password@127.0.0.1:3306/kindai

# Billing (required for Stripe checkout + webhooks)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Storage (required for PDF uploads and AI artefacts)
BUILT_IN_FORGE_API_URL=https://forge.example.com
BUILT_IN_FORGE_API_KEY=replace-me
VITE_FRONTEND_FORGE_API_URL=https://forge.example.com
VITE_FRONTEND_FORGE_API_KEY=replace-me

# Email & CRM (optional but recommended)
BREVO_API_KEY=
HUBSPOT_API_KEY=

# AI features (optional but recommended)
OPENAI_API_KEY=

# Frontend branding & analytics (optional)
VITE_APP_LOGO=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
