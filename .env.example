NODE_ENV=development
PORT=3000

# Authentication
# Supabase Auth powers the app login page and protected routes.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-or-anon-key
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-publishable-or-anon-key

# Legacy Manus OAuth fallback
VITE_APP_ID=kindai-estimating-suite
JWT_SECRET=replace-with-a-long-random-secret
OAUTH_SERVER_URL=https://oauth.example.com
VITE_OAUTH_PORTAL_URL=https://portal.example.com
OWNER_OPEN_ID=

# Database (required at startup)
DATABASE_URL=mysql://user:password@127.0.0.1:3306/kindai
# Future Supabase/Postgres migration target:
# SUPABASE_DB_URL=postgresql://postgres:password@db.project-ref.supabase.co:5432/postgres

# Billing (required for Stripe checkout + webhooks)
STRIPE_SECRET_KEY=sk_test_replace_me
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Storage (required for PDF uploads and AI artefacts)
BUILT_IN_FORGE_API_URL=https://forge.example.com
BUILT_IN_FORGE_API_KEY=replace-me
VITE_FRONTEND_FORGE_API_URL=https://forge.example.com
VITE_FRONTEND_FORGE_API_KEY=replace-me

# Email & CRM (optional but recommended)
BREVO_API_KEY=
HUBSPOT_API_KEY=
RESEND_API_KEY=
RESEND_FROM_EMAIL=Matt from Kindai <matt@kindaiestimator.com>
MATTHEW_NOTIFICATION_EMAIL=matt@kindaiestimator.com

# AI features (optional but recommended)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4

# Frontend branding & analytics (optional)
VITE_APP_LOGO=
VITE_ANALYTICS_ENDPOINT=
VITE_ANALYTICS_WEBSITE_ID=
VITE_ANALYTICS_SCRIPT_URL=
VITE_PLAUSIBLE_DOMAIN=
VITE_PLAUSIBLE_SCRIPT_URL=
VITE_ANALYTICS_ALLOW_EXISTING_TRACKERS=true
VITE_ANALYTICS_DISABLED=false

# Meta Pixel, domain verification & Conversions API (optional but strongly recommended for paid acquisition)
VITE_META_PIXEL_ID=1223641749636127
VITE_META_PIXEL_DISABLED=false
VITE_META_DOMAIN_VERIFICATION=
META_PIXEL_ID=1223641749636127
META_CONVERSIONS_API_ACCESS_TOKEN=
# Aliases supported by the CAPI service for deployment platforms that use FB_* naming.
FB_PIXEL_ID=1223641749636127
FB_ACCESS_TOKEN=
META_TEST_EVENT_CODE=
# Comma-separated list of browser origins allowed to POST to /api/leads and /api/leads/ebook.
LEAD_CAPTURE_ALLOWED_ORIGINS=https://kindaibook-55hbndtb.manus.space,https://kindaiestimator.com,https://www.kindaiestimator.com
WEBHOOK_SECRET=
FB_WEBHOOK_VERIFY_TOKEN=

# Kindai Ad Engine / Meta Marketing API (optional, mock mode without these)
META_MARKETING_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_000000000000000
META_MARKETING_API_VERSION=v21.0
META_PAGE_ID=

# Client-owned accounting and job-management integrations (optional)
# These are platform connector credentials, not Matthew's personal accounts.
# Customers authorize their own Xero, ServiceM8, MYOB, QuickBooks, Procore, etc. accounts.
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
SERVICEM8_API_KEY=
